[importlinter]
root_packages =
    yarvelle
include_external_packages = True

[importlinter:contract:finance_isolation]
name = Finance pack must not import other packs or health internals
type = forbidden
source_modules =
    yarvelle.finance
forbidden_modules =
    yarvelle.education
    yarvelle.household
    carefold

[importlinter:contract:education_isolation]
name = Education pack must not import other packs or health internals
type = forbidden
source_modules =
    yarvelle.education
forbidden_modules =
    yarvelle.finance
    yarvelle.household
    carefold

[importlinter:contract:household_isolation]
name = Household pack must not import other packs or health internals
type = forbidden
source_modules =
    yarvelle.household
forbidden_modules =
    yarvelle.finance
    yarvelle.education
    carefold
